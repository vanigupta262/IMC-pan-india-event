{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IGTS IMC Event Bot API - Snapshot",
  "type": "object",
  "required": ["version","round","player_id","n_players","islands","roads"],
  "properties": {
    "version": { "type": "string" },
    "round": { "type": "integer", "minimum": 0 },
    "player_id": { "type": "integer", "minimum": 0 },
    "n_players": { "type": "integer", "minimum": 2 },
    "islands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id","economy","degree"],
        "properties": {
          "id": { "type": "integer" },
          "economy": { "type": "number" },
          "degree": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "roads": {
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": { "type": "integer" }
      }
    },
    "history": { "type": "array" }
  }
}
